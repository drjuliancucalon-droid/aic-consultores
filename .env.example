# Copie este archivo como ".env" para desarrollo local:
#   cp .env.example .env
# En producción, configure las mismas variables en:
#   Cloudflare Pages → su proyecto → Settings → Environment variables
#
# Ninguna de estas variables es secreta por sí sola (todas las que empiezan
# con PUBLIC_ quedan visibles en el código del navegador). No agregue aquí
# claves API reales de servicios de correo/CRM: esas van solo como variable
# de entorno del lado servidor en Cloudflare Pages Functions (ver
# functions/api/contacto.ts).

# URL final del sitio en producción (sin "/" al final). Se usa para el
# sitemap.xml, las etiquetas canonical y Open Graph.
PUBLIC_SITE_URL=https://www.aicconsultores.co

# Número de WhatsApp Business en formato internacional, solo dígitos
# (código de país + número). Ejemplo Colombia: 57 + celular a 10 dígitos.
PUBLIC_WHATSAPP_NUMBER=573182213979

# Mensaje precargado al abrir el chat de WhatsApp desde el sitio.
PUBLIC_WHATSAPP_MENSAJE=Hola, quiero agendar un diagnóstico inicial gratuito.

# URL de su sistema de agenda en línea (Cal.com, Calendly, Google Calendar
# con reservas, etc.). El botón "Agendar diagnóstico inicial" enlaza aquí.
PUBLIC_AGENDA_URL=https://cal.com/aic-consultores/diagnostico-inicial

# Correo de contacto visible en el sitio (footer, página de contacto).
PUBLIC_CONTACT_EMAIL=dr.juliancucalon@gmail.com

# Endpoint donde se envían los formularios (contacto y descarga de
# recursos). Por defecto usa la función serverless incluida en
# /functions/api/contacto.ts. Puede reemplazarlo por un servicio externo
# (Formspree, HubSpot, etc.) si lo prefiere.
PUBLIC_FORM_ENDPOINT=/api/contacto

# Opcional: ID de Google Tag Manager (GTM-XXXXXXX). Si se deja vacío, el
# sitio no carga ningún script de analítica de terceros y los eventos
# (clic WhatsApp, envío de formulario, agendamiento, descarga de recurso)
# solo se envían a window.dataLayer para que usted decida a qué panel
# conectarlos.
PUBLIC_GTM_ID=
