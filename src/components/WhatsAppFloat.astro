---
import Icon from './Icon.astro';
import { whatsappHref } from '../data/site';
---

<a
  href={whatsappHref()}
  target="_blank"
  rel="noopener noreferrer"
  class="btn-whatsapp fixed bottom-5 right-5 z-40 !rounded-full !px-4 !py-4 shadow-cardHover print:hidden sm:!px-5"
  aria-label="Escribir por WhatsApp a AIC Consultores"
  data-analytics-event="clic_whatsapp"
  data-analytics-origin="barra_flotante"
>
  <Icon name="whatsapp" class="h-6 w-6" />
  <span class="hidden sm:inline">Escríbanos</span>
</a>
