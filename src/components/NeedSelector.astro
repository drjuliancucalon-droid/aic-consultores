---
import Icon from './Icon.astro';

const opciones = [
  {
    texto: 'Quiero ordenar mis finanzas',
    servicio: 'outsourcing-contable-tributario',
    icono: 'chart' as const,
  },
  {
    texto: 'Necesito SG-SST',
    servicio: 'sgsst',
    icono: 'shield' as const,
  },
  {
    texto: 'Quiero evaluar riesgos psicosociales',
    servicio: 'riesgo-psicosocial',
    icono: 'heart' as const,
  },
];
---

<div class="grid gap-3 sm:grid-cols-3">
  {opciones.map((op) => (
    <a
      href={`/contacto/?servicio=${op.servicio}`}
      class="group flex items-center gap-3 rounded-xl2 border-2 border-navy/15 bg-white px-5 py-4 text-left transition hover:border-teal-dark hover:bg-mist dark:border-white/15 dark:bg-navy-light dark:hover:border-gold"
    >
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-mist text-navy transition group-hover:bg-teal-dark group-hover:text-white dark:bg-white/10 dark:text-white">
        <Icon name={op.icono} class="h-5 w-5" />
      </span>
      <span class="font-display text-base text-navy dark:text-white">{op.texto}</span>
    </a>
  ))}
</div>
