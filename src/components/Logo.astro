---
// Logo AIC Consultores — SVG inline
// mark = solo hexágono (header compacto, favicon)
// full = hexágono + nombre completo horizontal
export interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{variant === 'mark' ? (
  <!-- Hexágono AIC — solo ícono -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 80 92"
    fill="none"
    aria-label="AIC Consultores"
    class={className}
  >
    <!-- Hexágono fondo navy -->
    <path d="M40 2 L76 22 L76 70 L40 90 L4 70 L4 22 Z" fill="#0D2640" stroke="#C9922B" stroke-width="3"/>
    <!-- Flecha/A hacia arriba -->
    <polygon points="40,14 54,36 46,36 46,52 34,52 34,36 26,36" fill="white"/>
    <!-- I -->
    <rect x="36" y="56" width="8" height="3" rx="1" fill="#C9922B"/>
    <!-- C -->
    <text x="40" y="76" text-anchor="middle" font-family="'Inter','Helvetica Neue',Arial,sans-serif" font-size="16" font-weight="700" fill="white" letter-spacing="2">IC</text>
    <!-- Línea gold horizontal (brújula) -->
    <line x1="10" y1="46" x2="30" y2="46" stroke="#C9922B" stroke-width="2" stroke-linecap="round"/>
    <line x1="50" y1="46" x2="70" y2="46" stroke="#C9922B" stroke-width="2" stroke-linecap="round"/>
  </svg>
) : (
  <!-- Logo completo horizontal -->
  <span class={`inline-flex items-center gap-3 ${className}`}>
    <!-- Hexágono -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 80 92"
      fill="none"
      aria-hidden="true"
      class="h-full w-auto shrink-0"
    >
      <path d="M40 2 L76 22 L76 70 L40 90 L4 70 L4 22 Z" fill="#0D2640" stroke="#C9922B" stroke-width="3"/>
      <polygon points="40,14 54,36 46,36 46,52 34,52 34,36 26,36" fill="white"/>
      <rect x="36" y="56" width="8" height="3" rx="1" fill="#C9922B"/>
      <text x="40" y="76" text-anchor="middle" font-family="'Inter','Helvetica Neue',Arial,sans-serif" font-size="16" font-weight="700" fill="white" letter-spacing="2">IC</text>
      <line x1="10" y1="46" x2="30" y2="46" stroke="#C9922B" stroke-width="2" stroke-linecap="round"/>
      <line x1="50" y1="46" x2="70" y2="46" stroke="#C9922B" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <!-- Texto -->
    <span class="flex flex-col leading-tight">
      <span class="font-display text-base font-bold tracking-tight text-navy dark:text-white sm:text-lg">
        Asesoría Integral
      </span>
      <span class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-[#C9922B]">
        Contadores · Consultores
      </span>
    </span>
  </span>
)}
