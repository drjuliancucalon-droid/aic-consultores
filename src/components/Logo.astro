---
// Logo AIC Consultores — SVG reconstruido fiel al mockup aprobado
// variant="mark"  → solo hexágono (favicon, watermark, footer)
// variant="full"  → hexágono + separador gold + texto (header)
export interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{variant === 'mark' ? (
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 120 138"
  fill="none"
  role="img"
  aria-label="AIC Consultores"
  class={className}
>
  <defs>
    <filter id="glow-m" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="5" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <linearGradient id="gold-m" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F2CC60"/>
      <stop offset="45%" stop-color="#C9922B"/>
      <stop offset="100%" stop-color="#EAB84A"/>
    </linearGradient>
    <linearGradient id="bg-m" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1E4068"/>
      <stop offset="100%" stop-color="#0D2640"/>
    </linearGradient>
  </defs>

  <!-- Halo dorado difuso -->
  <ellipse cx="60" cy="72" rx="48" ry="48" fill="#C9922B" opacity="0.22" filter="url(#glow-m)"/>

  <!-- Borde hexágono gold con glow -->
  <path d="M60 4 L110 31.5 L110 106.5 L60 134 L10 106.5 L10 31.5 Z"
        fill="url(#gold-m)" filter="url(#glow-m)"/>

  <!-- Relleno interior navy -->
  <path d="M60 13 L102 36.5 L102 101.5 L60 125 L18 101.5 L18 36.5 Z"
        fill="url(#bg-m)"/>

  <!-- Flecha — cabeza triangular -->
  <polygon points="60,17 82,52 71,52 71,54 49,54 49,52 38,52" fill="white"/>
  <!-- Flecha — cuerpo vertical -->
  <rect x="49" y="54" width="22" height="30" rx="1.5" fill="white"/>

  <!-- Brújula izquierda: línea + punta -->
  <line x1="16" y1="72" x2="40" y2="72" stroke="#C9922B" stroke-width="2.5" stroke-linecap="round"/>
  <polygon points="20,72 28,68 28,76" fill="#C9922B"/>

  <!-- Brújula derecha: línea + punta -->
  <line x1="80" y1="72" x2="104" y2="72" stroke="#C9922B" stroke-width="2.5" stroke-linecap="round"/>
  <polygon points="100,72 92,68 92,76" fill="#C9922B"/>

  <!-- IC grande blanco -->
  <text x="60" y="110"
    text-anchor="middle"
    font-family="'Inter','Helvetica Neue',Arial,sans-serif"
    font-size="24" font-weight="800"
    fill="white" letter-spacing="5">IC</text>
</svg>
) : (
<span class={`inline-flex items-center ${className}`}>

  <!-- Hexágono -->
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 138" fill="none"
       aria-hidden="true" class="h-full w-auto shrink-0">
    <defs>
      <filter id="glow-f" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="4" result="b"/>
        <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
      <linearGradient id="gold-f" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#F2CC60"/>
        <stop offset="45%" stop-color="#C9922B"/>
        <stop offset="100%" stop-color="#EAB84A"/>
      </linearGradient>
      <linearGradient id="bg-f" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1E4068"/>
        <stop offset="100%" stop-color="#0D2640"/>
      </linearGradient>
    </defs>
    <ellipse cx="60" cy="72" rx="48" ry="48" fill="#C9922B" opacity="0.20" filter="url(#glow-f)"/>
    <path d="M60 4 L110 31.5 L110 106.5 L60 134 L10 106.5 L10 31.5 Z"
          fill="url(#gold-f)" filter="url(#glow-f)"/>
    <path d="M60 13 L102 36.5 L102 101.5 L60 125 L18 101.5 L18 36.5 Z"
          fill="url(#bg-f)"/>
    <polygon points="60,17 82,52 71,52 71,54 49,54 49,52 38,52" fill="white"/>
    <rect x="49" y="54" width="22" height="30" rx="1.5" fill="white"/>
    <line x1="16" y1="72" x2="40" y2="72" stroke="#C9922B" stroke-width="2.5" stroke-linecap="round"/>
    <polygon points="20,72 28,68 28,76" fill="#C9922B"/>
    <line x1="80" y1="72" x2="104" y2="72" stroke="#C9922B" stroke-width="2.5" stroke-linecap="round"/>
    <polygon points="100,72 92,68 92,76" fill="#C9922B"/>
    <text x="60" y="110" text-anchor="middle"
      font-family="'Inter','Helvetica Neue',Arial,sans-serif"
      font-size="24" font-weight="800" fill="white" letter-spacing="5">IC</text>
  </svg>

  <!-- Separador vertical gold -->
  <span aria-hidden="true" class="mx-3 block shrink-0 self-center"
    style="width:1px;height:2.4em;background:linear-gradient(to bottom,transparent,#C9922B 20%,#C9922B 80%,transparent);"></span>

  <!-- Texto -->
  <span class="flex flex-col justify-center leading-none">
    <span class="font-display font-bold tracking-tight text-navy dark:text-white"
          style="font-size:1.22em;line-height:1.15;">Asesoría Integral</span>
    <span class="font-semibold uppercase text-[#C9922B]"
          style="font-size:0.50em;letter-spacing:0.17em;margin-top:0.28em;">Contadores · Consultores</span>
  </span>

</span>
)}
