---
// Logo AIC — siempre usa el PNG oficial /images/logo-aic.png
// variant="mark"  → solo el escudo (tamaño compacto)
// variant="full"  → escudo + texto (para hero, footer hero)
export interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{variant === 'mark' ? (
  <img
    src="/images/logo-aic.png"
    alt="Asesoría Integral — Contadores · Consultores"
    class={`object-contain ${className}`}
    width="1536"
    height="1024"
    loading="lazy"
    decoding="async"
  />
) : (
  <img
    src="/images/logo-aic.png"
    alt="Asesoría Integral — Contadores · Consultores"
    class={`object-contain ${className}`}
    width="1536"
    height="1024"
    loading="lazy"
    decoding="async"
  />
)}
