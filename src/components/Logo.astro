---
// Logo real de Asesoría Integral Contadores y Consultores, extraído del
// portafolio de marca. "full" = monograma + nombre (requiere fondo claro,
// el texto es negro); "mark" = solo el monograma "AI" en degradado.
export interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{variant === 'mark' ? (
  <img
    src="/images/logo-ai-mark.png"
    alt="Asesoría Integral Contadores y Consultores"
    width="261"
    height="94"
    class={className}
  />
) : (
  <img
    src="/images/logo-ai.png"
    alt="Asesoría Integral Contadores y Consultores"
    width="503"
    height="382"
    class={className}
  />
)}
