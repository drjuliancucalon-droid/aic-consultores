---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, navPrincipal } from '../data/site';

const year = new Date().getFullYear();

const enlacesLegales = [
  { label: 'Política de tratamiento de datos', href: '/legales/politica-tratamiento-datos/' },
  { label: 'Aviso de privacidad', href: '/legales/aviso-privacidad/' },
  { label: 'Términos y condiciones', href: '/legales/terminos-condiciones/' },
];
---

<footer class="border-t border-navy/10 bg-navy text-white/85 print:hidden dark:border-white/10">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <Logo class="h-9 w-auto text-white" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/70">{site.eslogan}</p>
    </div>

    <nav aria-label="Mapa del sitio">
      <h2 class="eyebrow text-gold-light">Navegación</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {navPrincipal.map((item) => (
          <li><a href={item.href} class="hover:text-gold-light">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow text-gold-light">Contacto</h2>
      <ul class="mt-3 space-y-3 text-sm">
        <li class="flex items-start gap-2">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-teal-light" />
          <span>{site.ciudad}, {site.departamento} — {site.pais}. Atención extramural.</span>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mail" class="h-4 w-4 shrink-0 text-teal-light" />
          <a href={`mailto:${site.correoContacto}`} class="hover:text-gold-light">{site.correoContacto}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-gold-light">Legal</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {enlacesLegales.map((item) => (
          <li><a href={item.href} class="hover:text-gold-light">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.nombreCorto}. Equipo de profesionales independientes en ejercicio coordinado.</p>
      <p>La información de este sitio es orientativa y no sustituye el concepto profesional individual sobre su caso particular.</p>
    </div>
  </div>
</footer>
