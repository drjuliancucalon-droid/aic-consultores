---
import Icon from './Icon.astro';
import { site, navPrincipal } from '../data/site';

const year = new Date().getFullYear();

const enlacesLegales = [
  { label: 'Política de tratamiento de datos', href: '/legales/politica-tratamiento-datos/' },
  { label: 'Aviso de privacidad', href: '/legales/aviso-privacidad/' },
  { label: 'Términos y condiciones', href: '/legales/terminos-condiciones/' },
];
---

<footer class="border-t border-navy/10 bg-navy text-white/85 print:hidden dark:border-white/10">

  <!-- Brand watermark section -->
  <div class="relative overflow-hidden border-b border-white/10 py-14">
    <div class="container-page relative flex flex-col items-center gap-5 text-center">

      <!-- Logo PNG oficial centrado en el hero del footer -->
      <img
        src="/images/logo-aic.png"
        alt="Asesoría Integral — Contadores · Consultores"
        class="h-24 w-auto object-contain"
        width="1536"
        height="1024"
        loading="lazy"
        decoding="async"
      />

      <div>
        <p class="font-display text-2xl font-bold text-white sm:text-3xl">Asesoría Integral</p>
        <p class="mt-1 text-sm font-semibold uppercase tracking-[0.2em] text-[#C9922B]">Contadores · Consultores</p>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-white/60">{site.eslogan}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/agendar/" class="btn bg-[#C9922B] text-navy font-bold hover:bg-[#E4AB37] hover:text-navy"
           data-analytics-event="clic_agendar" data-analytics-origin="footer_brand">
          Agendar diagnóstico
        </a>
        <a href="/calendario-tributario/" class="btn border border-white/20 text-white hover:bg-white/10">
          Calendario tributario 2026
        </a>
      </div>
    </div>
  </div>

  <!-- Links -->
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <!-- Logo PNG oficial en columna del footer -->
      <img
        src="/images/logo-aic.png"
        alt="Asesoría Integral"
        class="h-14 w-auto object-contain"
        width="1536"
        height="1024"
        loading="lazy"
        decoding="async"
      />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">{site.eslogan}</p>
    </div>

    <nav aria-label="Mapa del sitio">
      <h2 class="eyebrow text-[#C9922B]">Navegación</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {navPrincipal.map((item) => (
          <li><a href={item.href} class="text-white/70 hover:text-[#C9922B] transition">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow text-[#C9922B]">Contacto</h2>
      <ul class="mt-3 space-y-3 text-sm">
        <li class="flex items-start gap-2">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-teal-light" />
          <span class="text-white/70">{site.ciudad}, {site.departamento} — {site.pais}. Atención extramural.</span>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mail" class="h-4 w-4 shrink-0 text-teal-light" />
          <a href={`mailto:${site.correoContacto}`} class="text-white/70 hover:text-[#C9922B] transition">{site.correoContacto}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-[#C9922B]">Legal</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {enlacesLegales.map((item) => (
          <li><a href={item.href} class="text-white/70 hover:text-[#C9922B] transition">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.nombreCorto}. Equipo de profesionales independientes en ejercicio coordinado.</p>
      <p>La información de este sitio es orientativa y no sustituye el concepto profesional individual.</p>
    </div>
  </div>
</footer>
