---
// Barra de indicadores económicos Colombia 2026
// Fuente: DIAN, Mintrabajo — actualizar cada enero
const indicadores = [
  { label: 'Salario mínimo 2026', valor: '$1.423.500', detalle: 'Decreto 2343 de 2025' },
  { label: 'Subsidio de transporte', valor: '$200.800', detalle: 'Decreto 2344 de 2025' },
  { label: 'UVT 2026', valor: '$52.374', detalle: 'Resolución DIAN 000187/2025' },
  { label: 'Salud empleado (4%)', valor: '4%', detalle: 'Cotización a cargo del trabajador' },
  { label: 'Pensión empleado (4%)', valor: '4%', detalle: 'Cotización a cargo del trabajador' },
  { label: 'Próx. vencimiento', valor: 'IVA bimestral', detalle: 'Consulte fechas exactas →' },
];
---

<div class="border-b border-navy/8 bg-navy/[0.03] dark:border-white/8 dark:bg-white/[0.02]">
  <div class="container-page">
    <div class="flex items-center gap-1 overflow-x-auto py-2.5 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <span class="mr-3 shrink-0 text-[10px] font-bold uppercase tracking-widest text-teal-dark dark:text-gold-light">Indicadores 2026</span>
      {indicadores.map((ind, i) => (
        <>
          {i > 0 && <span class="mx-2 shrink-0 text-navy/20 dark:text-white/20">·</span>}
          <a
            href="/calendario-tributario/"
            class="group shrink-0 whitespace-nowrap text-xs text-ink-soft transition hover:text-navy dark:text-white/50 dark:hover:text-white"
            title={ind.detalle}
          >
            <span class="font-semibold text-navy dark:text-white">{ind.label}:</span>{' '}
            <span class="text-teal-dark dark:text-gold-light group-hover:underline">{ind.valor}</span>
          </a>
        </>
      ))}
      <span class="mx-2 shrink-0 text-navy/20 dark:text-white/20">·</span>
      <a
        href="/calendario-tributario/"
        class="shrink-0 whitespace-nowrap text-xs font-semibold text-teal-dark underline-offset-2 hover:underline dark:text-gold-light"
      >
        Ver calendario tributario →
      </a>
    </div>
  </div>
</div>
