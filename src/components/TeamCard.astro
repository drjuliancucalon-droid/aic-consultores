---
import Icon from './Icon.astro';
import type { MiembroEquipo } from '../data/equipo';

export interface Props { miembro: MiembroEquipo }
const { miembro } = Astro.props;
---

<article class="card flex h-full flex-col">
  <div class="flex items-start justify-between gap-3">
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-mist text-navy dark:bg-white/10 dark:text-white">
      <Icon name="users" class="h-6 w-6" />
    </div>
    {miembro.matricula && (
      <span class="inline-flex items-center gap-1.5 rounded-full bg-teal/10 px-3 py-1 text-xs font-semibold text-teal-dark">
        <Icon name="badge-check" class="h-3.5 w-3.5" /> {miembro.matricula}
      </span>
    )}
  </div>

  <h3 class="mt-4 font-display text-xl text-navy dark:text-white">
    {miembro.placeholder ? <span class="text-ink-soft dark:text-white/50">{miembro.nombre}</span> : miembro.nombre}
  </h3>
  <p class="mt-1 text-sm font-semibold text-teal-dark dark:text-gold-light">{miembro.rol}</p>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft dark:text-white/70">{miembro.enfoque}</p>

  {miembro.modalidad && (
    <p class="mt-3 text-xs text-ink-soft dark:text-white/50">{miembro.modalidad}</p>
  )}

  {miembro.contacto && (miembro.contacto.correo || miembro.contacto.telefono) && (
    <div class="mt-4 flex flex-col gap-1.5 border-t border-navy/10 pt-4 text-sm dark:border-white/10">
      {miembro.contacto.correo && (
        <a href={`mailto:${miembro.contacto.correo}`} class="flex items-center gap-2 text-navy hover:text-teal-dark dark:text-white">
          <Icon name="mail" class="h-4 w-4 text-teal-dark dark:text-gold-light" /> {miembro.contacto.correo}
        </a>
      )}
      {miembro.contacto.telefono && (
        <a href={`tel:+57${miembro.contacto.telefono}`} class="flex items-center gap-2 text-navy hover:text-teal-dark dark:text-white">
          <Icon name="phone" class="h-4 w-4 text-teal-dark dark:text-gold-light" /> {miembro.contacto.telefono}
        </a>
      )}
    </div>
  )}
</article>
