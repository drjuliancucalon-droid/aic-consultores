---
import Icon from './Icon.astro';
import type { MiembroEquipo } from '../data/equipo';

export interface Props {
  miembro: MiembroEquipo;
  accent?: string;
  delay?: number;
  size?: 'large' | 'small';
}
const { miembro, accent = '#00897B', delay = 0, size = 'large' } = Astro.props;
const isSmall = size === 'small';
---

<article class="card card-accent flex h-full flex-col !p-0 overflow-hidden" style={`--accent:${accent}`} data-reveal data-reveal-delay={delay}>
  <div class={`relative w-full overflow-hidden bg-mist dark:bg-white/5 ${isSmall ? 'aspect-square' : 'aspect-[4/5]'}`}>
    <img
      src={miembro.foto}
      alt={`Foto de ${miembro.nombre}`}
      class="h-full w-full object-cover object-top transition duration-500 hover:scale-105"
      loading="lazy"
      width="480"
      height="600"
    />
    {miembro.matricula && (
      <span class="absolute right-2 top-2 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1 text-[0.65rem] font-semibold text-teal-dark shadow-card backdrop-blur-sm">
        <Icon name="badge-check" class="h-3 w-3" /> {miembro.matricula}
      </span>
    )}
  </div>

  <div class={isSmall ? 'flex flex-1 flex-col p-4' : 'flex flex-1 flex-col p-6'}>
    <h3 class={`font-display text-navy dark:text-white ${isSmall ? 'text-base' : 'text-xl'}`}>{miembro.nombre}</h3>
    <p class={`mt-0.5 font-semibold text-teal-dark dark:text-gold-light ${isSmall ? 'text-xs' : 'mt-1 text-sm'}`}>{miembro.rol}</p>

    {!isSmall && (
      <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft dark:text-white/70">{miembro.enfoque}</p>
    )}
    {isSmall && (
      <p class="mt-2 flex-1 text-xs leading-relaxed text-ink-soft dark:text-white/70">{miembro.enfoque}</p>
    )}

    {miembro.modalidad && !isSmall && (
      <p class="mt-3 text-xs text-ink-soft dark:text-white/50">{miembro.modalidad}</p>
    )}

    {miembro.contacto && (miembro.contacto.correo || miembro.contacto.telefono) && (
      <div class={`mt-3 flex flex-col gap-1.5 border-t border-navy/10 pt-3 dark:border-white/10 ${isSmall ? 'text-xs' : 'text-sm'}`}>
        {miembro.contacto.correo && (
          <a href={`mailto:${miembro.contacto.correo}`} class="flex items-center gap-2 truncate text-navy hover:text-teal-dark dark:text-white">
            <Icon name="mail" class={`shrink-0 text-teal-dark dark:text-gold-light ${isSmall ? 'h-3.5 w-3.5' : 'h-4 w-4'}`} /> <span class="truncate">{miembro.contacto.correo}</span>
          </a>
        )}
        {miembro.contacto.telefono && (
          <a href={`tel:+57${miembro.contacto.telefono}`} class="flex items-center gap-2 text-navy hover:text-teal-dark dark:text-white">
            <Icon name="phone" class={`shrink-0 text-teal-dark dark:text-gold-light ${isSmall ? 'h-3.5 w-3.5' : 'h-4 w-4'}`} /> {miembro.contacto.telefono}
          </a>
        )}
      </div>
    )}
  </div>
</article>
