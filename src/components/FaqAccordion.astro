---
import Icon from './Icon.astro';

export interface Props {
  items: ReadonlyArray<{ pregunta: string; respuesta: string }>;
}
const { items } = Astro.props;
---

<div class="divide-y divide-navy/10 rounded-xl2 border border-navy/10 bg-white dark:divide-white/10 dark:border-white/10 dark:bg-navy-light">
  {items.map((item) => (
    <details class="group open:bg-mist/40 dark:open:bg-white/5" name="faq-inicio">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-base text-navy [&::-webkit-details-marker]:hidden dark:text-white sm:px-6 sm:text-lg">
        {item.pregunta}
        <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-teal-dark transition-transform duration-200 group-open:rotate-180 dark:text-gold-light" />
      </summary>
      <div class="px-5 pb-5 text-sm leading-relaxed text-ink-soft dark:text-white/70 sm:px-6 sm:text-base">
        {item.respuesta}
      </div>
    </details>
  ))}
</div>
