---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCard from '../components/TeamCard.astro';
import { equipo as equipoEstatico } from '../data/equipo';

const env = (Astro.locals as any).runtime?.env;
let equipo = equipoEstatico;

if (env?.DB) {
  const { listTeamMembers } = await import('../lib/admin/team');
  const registros = await listTeamMembers(env);
  if (registros.length > 0) {
    equipo = registros
      .filter((m: any) => m.publicado)
      .map((m: any) => ({
        id: m.slug,
        nombre: m.nombre,
        rol: m.cargo,
        area: m.area || 'sgsst',
        matricula: m.matricula,
        enfoque: m.resumen,
        contacto: {},
        foto: m.foto_url || '/images/equipo/placeholder.png',
      })) as any;
  }
}

const contadores = equipo.filter((m: any) => m.area === 'contable');
const otros = equipo.filter((m: any) => m.area !== 'contable');
---

<BaseLayout
  title="Equipo"
  description="Profesionales responsables detrás de Asesoría Integral Contadores y Consultores: contabilidad, medicina laboral, medicina general y psicología organizacional."
  path="/equipo/"
>
  <section class="bg-mist py-14 dark:bg-white/[0.03]">
    <div class="container-page">
      <p class="eyebrow" data-reveal>Equipo</p>
      <h1 class="mt-2 max-w-2xl font-display text-4xl text-navy dark:text-white" data-reveal data-reveal-delay="60">Profesionales, no una plantilla genérica</h1>
      <p class="mt-3 max-w-2xl text-ink-soft dark:text-white/70" data-reveal data-reveal-delay="120">
        Cada disciplina la lidera un profesional identificado, con su enfoque y, donde aplica, su matrícula o licencia verificable.
      </p>
    </div>
  </section>

  <section class="container-page py-16">
    <h2 class="font-display text-2xl text-navy dark:text-white" data-reveal>Nuestros contadores</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {contadores.map((m: any, i: number) => <TeamCard miembro={m} accent={['#00897B', '#0D2640', '#2F8132'][i % 3]} delay={i * 80} size="large" />)}
    </div>

    <h2 class="mt-16 font-display text-2xl text-navy dark:text-white" data-reveal>Salud ocupacional y bienestar laboral</h2>
    <div class="mx-auto mt-6 grid max-w-4xl gap-5 sm:grid-cols-3">
      {otros.map((m: any, i: number) => <TeamCard miembro={m} accent={['#2F8132', '#0D2640', '#00897B'][i % 3]} delay={i * 80} size="small" />)}
    </div>
  </section>
</BaseLayout>
