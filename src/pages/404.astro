---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que busca no existe o fue movida."
  path="/404/"
  noindex={true}
>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-display text-6xl text-gold">404</p>
    <h1 class="mt-3 font-display text-3xl text-navy dark:text-white">No encontramos esa página</h1>
    <p class="mt-3 max-w-md text-ink-soft dark:text-white/70">
      Puede que el enlace esté desactualizado o la página se haya movido. Vuelva al inicio o cuéntenos qué necesitaba.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Ir al inicio</a>
      <a href="/contacto/" class="btn-secondary">
        Contactar <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>
</BaseLayout>
