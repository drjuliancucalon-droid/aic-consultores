---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';

const todos = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);

const categorias = [
  { id: 'contabilidad-financiera', titulo: 'Contabilidad General y Financiera', accent: '#00897B' },
  { id: 'revisoria-auditoria', titulo: 'Revisoría Fiscal y Auditoría', accent: '#0D2640' },
  { id: 'tributario', titulo: 'Gestión Tributaria e Impuestos', accent: '#00695C' },
  { id: 'financiera-consultoria', titulo: 'Asesoría Financiera y Consultoría', accent: '#2F8132' },
  { id: 'nomina-sgsst', titulo: 'Nómina, Seguridad Social y SG-SST', accent: '#0D2640' },
  { id: 'tramites-adicionales', titulo: 'Trámites y procesos adicionales', accent: '#00897B' },
] as const;
---

<BaseLayout
  title="Servicios"
  description="Contabilidad, revisoría fiscal, gestión tributaria, asesoría financiera, nómina y SG-SST, y trámites adicionales. Cotización según alcance."
  path="/servicios/"
>
  <section class="bg-mist py-14 dark:bg-white/[0.03]">
    <div class="container-page">
      <p class="eyebrow" data-reveal>Servicios</p>
      <h1 class="mt-2 max-w-2xl font-display text-4xl text-navy dark:text-white" data-reveal data-reveal-delay="60">Qué hacemos, y qué no</h1>
      <p class="mt-3 max-w-2xl text-ink-soft dark:text-white/70" data-reveal data-reveal-delay="120">
        Cada servicio tiene un alcance definido y un responsable profesional. El valor exacto siempre se cotiza según el alcance particular de su empresa.
      </p>
    </div>
  </section>

  <nav class="container-page flex flex-wrap gap-2 py-8" aria-label="Categorías de servicios" data-reveal>
    {categorias.map((cat) => (
      <a href={`#${cat.id}`} class="rounded-full border border-navy/15 px-4 py-1.5 text-xs font-semibold text-navy transition hover:border-teal-dark hover:text-teal-dark dark:border-white/15 dark:text-white">
        {cat.titulo}
      </a>
    ))}
  </nav>

  {categorias.map((cat) => {
    const items = todos.filter((s) => s.data.categoria === cat.id);
    if (items.length === 0) return null;
    return (
      <section id={cat.id} class="container-page scroll-mt-24 py-10">
        <h2 class="font-display text-2xl text-navy dark:text-white" data-reveal>{cat.titulo}</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((s, i) => (
            <ServiceCard
              slug={s.slug}
              titulo={s.data.titulo}
              resumen={s.data.resumen}
              responsable={s.data.responsable}
              modalidad={s.data.modalidad}
              accent={cat.accent}
              delay={i * 80}
            />
          ))}
        </div>
      </section>
    );
  })}

  <section class="container-page pb-20 pt-6">
    <div class="rounded-xl2 border border-navy/10 bg-white p-6 text-sm text-ink-soft dark:border-white/10 dark:bg-navy-light dark:text-white/70" data-reveal>
      Los servicios médicos y ocupacionales de este sitio se prestan dentro del alcance profesional habilitado y el marco regulatorio aplicable. Ningún servicio de este listado constituye una promesa de resultado tributario, médico, psicológico o jurídico.
    </div>
  </section>
</BaseLayout>
