---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

export interface Props { entry: CollectionEntry<'servicios'> }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
---

<BaseLayout
  title={data.titulo}
  description={data.resumen}
  path={`/servicios/${entry.slug}/`}
>
  <section class="bg-mist py-14 dark:bg-white/[0.03]">
    <div class="container-page">
      <a href="/servicios/" class="text-sm font-semibold text-teal-dark hover:underline dark:text-gold-light">← Todos los servicios</a>
      <h1 class="mt-3 max-w-2xl font-display text-4xl text-navy dark:text-white">{data.titulo}</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-soft dark:text-white/70">{data.resumen}</p>
      <a href={`/contacto/?servicio=${entry.slug}`} class="btn-primary mt-6 inline-flex">Cotizar según alcance</a>
    </div>
  </section>

  <section class="container-page py-14">
    <div class="grid gap-3 rounded-xl2 border border-navy/10 bg-white p-6 dark:border-white/10 dark:bg-navy-light sm:grid-cols-2">
      <div>
        <p class="eyebrow">Responsable</p>
        <p class="mt-1 text-sm text-ink dark:text-white/85">{data.responsable}</p>
      </div>
      <div>
        <p class="eyebrow">Modalidad</p>
        <p class="mt-1 text-sm text-ink dark:text-white/85">{data.modalidad}</p>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="font-display text-xl text-navy dark:text-white">Qué resuelve</h2>
      <p class="mt-3 max-w-3xl text-ink-soft dark:text-white/75">{data.queResuelve}</p>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-xl text-navy dark:text-white">Incluye</h2>
        <ul class="mt-4 space-y-3">
          {data.incluye.map((item) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-soft dark:text-white/75">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-dark dark:text-gold-light" /> {item}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="font-display text-xl text-navy dark:text-white">No incluye</h2>
        <ul class="mt-4 space-y-3">
          {data.noIncluye.map((item) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-soft dark:text-white/75">
              <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-navy/40 dark:text-white/40" /> {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="prose prose-slate mt-12 max-w-none dark:prose-invert prose-headings:font-display prose-headings:text-navy dark:prose-headings:text-white prose-a:text-teal-dark">
      <Content />
    </div>

    <div class="mt-12 flex flex-wrap items-center gap-4 rounded-xl2 bg-navy p-6 dark:bg-navy-light sm:p-8">
      <p class="flex-1 font-display text-lg text-white">¿Aplica a su empresa? Cotizamos según el alcance real.</p>
      <a href={`/contacto/?servicio=${entry.slug}`} class="btn bg-gold text-navy hover:bg-white">Solicitar cotización</a>
    </div>
  </section>
</BaseLayout>
