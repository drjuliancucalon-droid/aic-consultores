---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecursoDescarga from '../../components/RecursoDescarga.astro';

export async function getStaticPaths() {
  const recursos = await getCollection('recursos');
  return recursos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

export interface Props { entry: CollectionEntry<'recursos'> }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
---

<BaseLayout
  title={data.titulo}
  description={data.descripcion}
  path={`/recursos/${entry.slug}/`}
>
  <article class="container-page py-14 sm:py-16">
    <a href="/recursos/" class="text-sm font-semibold text-teal-dark hover:underline dark:text-gold-light">← Todos los recursos</a>
    <h1 class="mt-3 max-w-3xl font-display text-4xl text-navy dark:text-white">{data.titulo}</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft dark:text-white/70">{data.descripcion}</p>

    <div class="prose prose-slate mt-10 max-w-3xl dark:prose-invert prose-headings:font-display prose-headings:text-navy dark:prose-headings:text-white prose-a:text-teal-dark prose-strong:text-navy dark:prose-strong:text-white">
      <Content />
    </div>

    <div class="mt-4 max-w-3xl print:hidden">
      <RecursoDescarga recursoSlug={entry.slug} recursoTitulo={data.titulo} />
    </div>
  </article>
</BaseLayout>
