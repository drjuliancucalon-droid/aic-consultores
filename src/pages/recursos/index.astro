---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const recursos = (await getCollection('recursos')).sort(
  (a, b) => b.data.fechaPublicacion.valueOf() - a.data.fechaPublicacion.valueOf()
);

const etiquetaTipo: Record<string, string> = {
  checklist: 'Checklist',
  guia: 'Guía',
  calendario: 'Calendario',
};
---

<BaseLayout
  title="Recursos"
  description="Checklists y guías descargables sobre obligaciones tributarias, SG-SST y organización documental para pymes."
  path="/recursos/"
>
  <section class="bg-mist py-14 dark:bg-white/[0.03]">
    <div class="container-page">
      <p class="eyebrow">Recursos</p>
      <h1 class="mt-2 max-w-2xl font-display text-4xl text-navy dark:text-white">Guías para poner en orden su empresa</h1>
      <p class="mt-3 max-w-2xl text-ink-soft dark:text-white/70">
        Contenido orientativo y general. No reemplaza el concepto profesional sobre el caso particular de su empresa.
      </p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recursos.map((r) => (
        <a href={`/recursos/${r.slug}/`} class="card group flex flex-col">
          <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-teal/10 px-3 py-1 text-xs font-semibold text-teal-dark">
            <Icon name="file-text" class="h-3.5 w-3.5" /> {etiquetaTipo[r.data.tipo]}
          </span>
          <h2 class="mt-3 font-display text-xl text-navy dark:text-white">{r.data.titulo}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft dark:text-white/70">{r.data.descripcion}</p>
          <div class="mt-4 flex items-center justify-between text-xs text-ink-soft dark:text-white/50">
            {r.data.tiempoLectura && <span>{r.data.tiempoLectura} de lectura</span>}
            <span class="inline-flex items-center gap-1 font-semibold text-teal-dark dark:text-gold-light">
              Leer guía <Icon name="arrow-right" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
