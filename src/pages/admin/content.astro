---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin · Contenido" description="Gestión de contenido">
  <section class="container mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Contenido</h1>
    <p class="mt-2 text-sm text-slate-600">Administra servicios, soluciones, recursos, FAQs y secciones del home.</p>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-sm text-slate-600">
      Módulo base listo para conectar `content_entries`, `faq_items` y `homepage_sections`.
    </div>
  </section>
</BaseLayout>
