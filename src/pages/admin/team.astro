---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin · Equipo" description="Gestión del equipo">
  <section class="container mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Equipo</h1>
    <p class="mt-2 text-sm text-slate-600">Administra nombres, cargos, matrículas y biografías profesionales.</p>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-sm text-slate-600">
      Módulo base listo para conectarse a `team_members` en D1.
    </div>
  </section>
</BaseLayout>
