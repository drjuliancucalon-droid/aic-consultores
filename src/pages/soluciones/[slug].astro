---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export const prerender = true;

export async function getStaticPaths() {
  const soluciones = await getCollection('soluciones');
  return soluciones.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

export interface Props { entry: CollectionEntry<'soluciones'> }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

const servicios = await getCollection('servicios');
function buscarServicio(nombre: string) {
  return servicios.find((s) => s.data.titulo === nombre || s.slug === nombre);
}
---

<BaseLayout
  title={data.titulo}
  description={data.resumen}
  path={`/soluciones/${entry.slug}/`}
>
  <section class="bg-mist py-14 dark:bg-white/[0.03]">
    <div class="container-page">
      <p class="eyebrow">{data.segmento}</p>
      <h1 class="mt-2 max-w-2xl font-display text-4xl text-navy dark:text-white">{data.titulo}</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-soft dark:text-white/70">{data.resumen}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/contacto/?sector=${entry.slug}`} class="btn-primary">Agendar diagnóstico inicial</a>
        <a href="/soluciones/" class="btn-secondary">Ver otras soluciones</a>
      </div>
    </div>
  </section>

  <section class="container-page grid gap-10 py-16 lg:grid-cols-2">
    <div>
      <h2 class="font-display text-xl text-navy dark:text-white">Problemas típicos</h2>
      <ul class="mt-4 space-y-3">
        {data.problemasTipicos.map((p) => (
          <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-soft dark:text-white/75">
            <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-navy/40 dark:text-white/40" /> {p}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-display text-xl text-navy dark:text-white">Entregables</h2>
      <ul class="mt-4 space-y-3">
        {data.entregables.map((e) => (
          <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-soft dark:text-white/75">
            <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-dark dark:text-gold-light" /> {e}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-navy py-16 dark:bg-navy-dark">
    <div class="container-page">
      <h2 class="font-display text-xl text-white">Servicios sugeridos</h2>
      <div class="mt-5 flex flex-wrap gap-3">
        {data.serviciosSugeridos.map((nombre) => {
          const servicio = buscarServicio(nombre);
          return servicio ? (
            <a href={`/servicios/${servicio.slug}/`} class="rounded-full border border-white/25 px-4 py-2 text-sm text-white transition hover:border-gold hover:text-gold-light">
              {servicio.data.titulo}
            </a>
          ) : (
            <span class="rounded-full border border-white/25 px-4 py-2 text-sm text-white/80">{nombre}</span>
          );
        })}
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-display prose-headings:text-navy dark:prose-headings:text-white prose-a:text-teal-dark">
      <Content />
    </div>

    <div class="mt-10 rounded-xl2 border border-navy/10 bg-mist p-6 dark:border-white/10 dark:bg-white/5">
      <h2 class="font-display text-lg text-navy dark:text-white">Este acompañamiento no incluye</h2>
      <ul class="mt-3 space-y-2">
        {data.exclusiones.map((ex) => (
          <li class="flex items-start gap-2.5 text-sm text-ink-soft dark:text-white/70">
            <Icon name="x" class="mt-0.5 h-4 w-4 shrink-0 text-navy/40 dark:text-white/40" /> {ex}
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={`/contacto/?sector=${entry.slug}`} class="btn-primary">Agendar diagnóstico inicial</a>
    </div>
  </section>
</BaseLayout>
