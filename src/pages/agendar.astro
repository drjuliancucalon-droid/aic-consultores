---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { whatsappHref } from '../data/site';
---

<BaseLayout
  title="Agendar diagnóstico inicial"
  description="Reserve su diagnóstico inicial de 30 minutos con el Dr. Julián Cucalón. Sin costo, sin obligación. Elija el horario que mejor le funcione."
  path="/agendar/"
>
  <!-- Hero compacto -->
  <section class="bg-mist py-12 dark:bg-white/[0.03]">
    <div class="container-page">
      <p class="eyebrow" data-reveal>Agenda en línea</p>
      <h1 class="mt-2 max-w-2xl font-display text-4xl text-navy dark:text-white" data-reveal data-reveal-delay="60">
        Diagnóstico inicial gratuito
      </h1>
      <p class="mt-3 max-w-xl text-ink-soft dark:text-white/70" data-reveal data-reveal-delay="120">
        30 minutos con el Dr. Julián Cucalón. Cuéntenos de su empresa y le decimos con franqueza cómo podemos ayudarle. Sin costo y sin obligación.
      </p>

      <div class="mt-5 flex flex-wrap gap-3 text-sm" data-reveal data-reveal-delay="180">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-navy/10 bg-white px-3 py-1.5 text-ink dark:border-white/10 dark:bg-navy-light dark:text-white/80">
          <Icon name="calendar" class="h-4 w-4 text-teal-dark dark:text-gold-light" />
          30 minutos
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-navy/10 bg-white px-3 py-1.5 text-ink dark:border-white/10 dark:bg-navy-light dark:text-white/80">
          <Icon name="shield" class="h-4 w-4 text-teal-dark dark:text-gold-light" />
          Sin costo
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-navy/10 bg-white px-3 py-1.5 text-ink dark:border-white/10 dark:bg-navy-light dark:text-white/80">
          <Icon name="chart" class="h-4 w-4 text-teal-dark dark:text-gold-light" />
          Sin obligación
        </span>
      </div>
    </div>
  </section>

  <!-- Embed de Cal.com -->
  <section class="container-page py-10">
    <div class="grid gap-10 lg:grid-cols-[1fr_20rem]">

      <!-- Widget incrustado -->
      <div class="min-h-[600px] overflow-hidden rounded-2xl border border-navy/10 bg-white shadow-sm dark:border-white/10 dark:bg-navy-light">
        <div id="cal-embed" class="h-full min-h-[600px] w-full"></div>
      </div>

      <!-- Columna lateral informativa -->
      <aside class="space-y-6">
        <div class="card">
          <Icon name="calendar" class="h-6 w-6 text-teal-dark dark:text-gold-light" />
          <h2 class="mt-3 font-display text-lg text-navy dark:text-white">¿Qué pasa en el diagnóstico?</h2>
          <ul class="mt-3 space-y-2 text-sm text-ink-soft dark:text-white/70">
            <li class="flex gap-2"><span class="mt-0.5 text-teal-dark dark:text-gold-light">✓</span> Entiende su situación contable y tributaria actual</li>
            <li class="flex gap-2"><span class="mt-0.5 text-teal-dark dark:text-gold-light">✓</span> Evalúa el estado de su SG-SST si aplica</li>
            <li class="flex gap-2"><span class="mt-0.5 text-teal-dark dark:text-gold-light">✓</span> Identifica riesgos prioritarios para su empresa</li>
            <li class="flex gap-2"><span class="mt-0.5 text-teal-dark dark:text-gold-light">✓</span> Le dice con franqueza si puede ayudarle y cómo</li>
          </ul>
        </div>

        <div class="card">
          <Icon name="whatsapp" class="h-6 w-6 text-teal-dark dark:text-gold-light" />
          <h2 class="mt-3 font-display text-lg text-navy dark:text-white">¿Prefiere WhatsApp?</h2>
          <p class="mt-1.5 text-sm text-ink-soft dark:text-white/70">
            Si ningún horario le funciona, escríbanos directamente y coordinamos.
          </p>
          <a
            href={whatsappHref()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp mt-4 w-full"
            data-analytics-event="clic_whatsapp"
            data-analytics-origin="agendar"
          >
            <Icon name="whatsapp" class="h-4 w-4" /> Abrir WhatsApp
          </a>
        </div>

        <div class="rounded-xl2 border border-navy/10 bg-white p-5 text-sm text-ink-soft dark:border-white/10 dark:bg-navy-light dark:text-white/70">
          <p class="flex items-start gap-2">
            <Icon name="shield" class="mt-0.5 h-4 w-4 shrink-0 text-teal-dark dark:text-gold-light" />
            Este canal es solo para agendar. No envíe por aquí historias clínicas, diagnósticos ni resultados de exámenes.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<!-- Cal.com inline embed — NO mover dentro del frontmatter -->
<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        typeof namespace === 'string'
          ? ((cal.ns[namespace] = api) && p(api, ar))
          : p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', 'diagnostico', { origin: 'https://cal.com' });

  Cal.ns['diagnostico']('inline', {
    elementOrSelector: '#cal-embed',
    config: {
      layout: 'month_view',
      theme: 'light',
    },
    calLink: 'julian-cucalon-kpdhib',
  });

  Cal.ns['diagnostico']('ui', {
    hideEventTypeDetails: false,
    layout: 'month_view',
  });
</script>
