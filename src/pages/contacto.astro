---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappHref } from '../data/site';
---

<BaseLayout
  title="Contacto"
  description="Agende un diagnóstico inicial de 30 minutos, sin costo, por formulario, WhatsApp o agenda en línea."
  path="/contacto/"
>
  <section class="bg-mist py-14 dark:bg-white/[0.03]">
    <div class="container-page">
      <p class="eyebrow">Contacto</p>
      <h1 class="mt-2 max-w-2xl font-display text-4xl text-navy dark:text-white">Empecemos con el diagnóstico inicial</h1>
      <p class="mt-3 max-w-2xl text-ink-soft dark:text-white/70">
        30 minutos, sin costo y sin obligación. Cuéntenos de su empresa y le contactamos por correo o WhatsApp.
      </p>
    </div>
  </section>

  <section class="container-page grid gap-10 py-16 lg:grid-cols-[1fr_22rem]">
    <div class="card">
      <h2 class="font-display text-xl text-navy dark:text-white">Formulario de contacto</h2>
      <div class="mt-6">
        <ContactForm />
      </div>
    </div>

    <aside class="space-y-6">
      <div class="card">
        <Icon name="calendar" class="h-6 w-6 text-teal-dark dark:text-gold-light" />
        <h2 class="mt-3 font-display text-lg text-navy dark:text-white">Agende directamente</h2>
        <p class="mt-1.5 text-sm text-ink-soft dark:text-white/70">
          Si prefiere elegir usted mismo el horario, use nuestra agenda en línea.
        </p>
        <a href={site.agendaUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary mt-4 w-full" data-analytics-event="clic_agendar" data-analytics-origin="contacto">
          Abrir agenda en línea
        </a>
      </div>

      <div class="card">
        <Icon name="whatsapp" class="h-6 w-6 text-teal-dark dark:text-gold-light" />
        <h2 class="mt-3 font-display text-lg text-navy dark:text-white">Escríbanos por WhatsApp</h2>
        <p class="mt-1.5 text-sm text-ink-soft dark:text-white/70">
          Para una respuesta más ágil a preguntas puntuales.
        </p>
        <a href={whatsappHref()} target="_blank" rel="noopener noreferrer" class="btn-whatsapp mt-4 w-full" data-analytics-event="clic_whatsapp" data-analytics-origin="contacto">
          <Icon name="whatsapp" class="h-4 w-4" /> Abrir WhatsApp
        </a>
      </div>

      <div class="rounded-xl2 border border-navy/10 bg-white p-6 text-sm text-ink-soft dark:border-white/10 dark:bg-navy-light dark:text-white/70">
        <p class="flex items-start gap-2">
          <Icon name="shield" class="mt-0.5 h-4 w-4 shrink-0 text-teal-dark dark:text-gold-light" />
          Ninguno de estos canales es para enviar historias clínicas, diagnósticos ni resultados de exámenes. Esa información se gestiona solo por el canal confidencial que el profesional a cargo le indique.
        </p>
      </div>
    </aside>
  </section>
</BaseLayout>
