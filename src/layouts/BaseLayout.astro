---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, path, noindex, ogImage } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

<!doctype html>
<html lang="es-CO" class="scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D2640" />

    <SEO title={title} description={description} path={path} noindex={noindex} ogImage={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
    />

    <script is:inline>
      // Se ejecuta antes de pintar para evitar el parpadeo claro→oscuro.
      (function () {
        const saved = localStorage.getItem('aic-theme');
        const prefiere = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefiere)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          const f = d.getElementsByTagName(s)[0];
          const j = d.createElement(s);
          const dl = l !== 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}

  </head>
  <body class="bg-white dark:bg-navy-dark">
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      import { bindDeclarativeEvents } from '../scripts/analytics';
      import { initScrollReveal } from '../scripts/reveal';
      bindDeclarativeEvents();
      initScrollReveal();
    </script>
  </body>
</html>
